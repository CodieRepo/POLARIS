# ==================================================
# POLARIS — Environment Configuration
# ==================================================
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local or any file containing real credentials.
# ==================================================

# --------------------------------------------------
# Supabase
# --------------------------------------------------

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER-SIDE ONLY
# This key bypasses RLS. NEVER expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------
# External Integrations
# --------------------------------------------------

# Copernicus Climate Data Store (ERA5)
ERA5_API_URL=https://cds.climate.copernicus.eu/api
ERA5_API_KEY=

# National Snow and Ice Data Center (NSIDC)
NSIDC_API_URL=https://nsidc.org/api

# National Centre for Polar and Ocean Research (NPDC)
NPDC_API_URL=

# --------------------------------------------------
# Application
# --------------------------------------------------

# Application environment (development | staging | production)
NODE_ENV=development
